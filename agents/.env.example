# Mẫu cấu hình API keys
# Sao chép file này thành .env và điền API key của bạn

# === Google Gemini ===
GOOGLE_API_KEY=your_google_api_key_here

# === OpenAI ===
OPENAI_API_KEY=your_openai_api_key_here

# === Anthropic Claude ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Groq (miễn phí, nhanh) ===
GROQ_API_KEY=your_groq_api_key_here

# === Ollama (local, không cần key) ===
OLLAMA_BASE_URL=http://localhost:11434

# === Cấu hình mặc định ===
# Model mặc định cho supervisor: gemini, openai, anthropic, groq, ollama
DEFAULT_MODEL=gemini

# Tên model cụ thể (để trống = dùng model mặc định của provider)
# DEFAULT_MODEL_NAME=gemini-1.5-flash
